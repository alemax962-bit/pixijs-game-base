# Copy to .env and fill in. Never commit .env — it is gitignored.
# All API tokens / secrets for this repo live here.

# Replicate — AI image / audio / video generation
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# npm granular access token — publish create-pixijs-game (security-key / bypass-2FA)
# https://www.npmjs.com/settings/~/tokens
# Permissions: Read and write (publish and stage) + Bypass two-factor authentication
NPM_TOKEN=

# Optional: override default output directory for generated assets
# ASSET_OUTPUT_DIR=public/assets
